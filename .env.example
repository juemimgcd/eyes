EYES_DATABASE_URL=postgresql+psycopg://eyes:eyes@127.0.0.1:5432/eyes
# Per process: include API workers, scheduler and maintenance in the total budget.
EYES_DATABASE_POOL_SIZE=8
EYES_DATABASE_MAX_OVERFLOW=0
EYES_DATABASE_POOL_TIMEOUT_SECONDS=5
EYES_MAX_PENDING_EXECUTION_RUNS=100000
EYES_REDIS_URL=redis://127.0.0.1:6379/0
EYES_REDIS_MAX_CONNECTIONS=16
EYES_REDIS_CONNECT_TIMEOUT_SECONDS=1
EYES_REDIS_TIMEOUT_SECONDS=2
EYES_REDIS_NAMESPACE=eyes
# Required for queued result delivery and optional queued events; direct APIs remain available.
EYES_RABBITMQ_URL=amqp://eyes:eyes@127.0.0.1:5672/%2F
EYES_EVENT_QUEUE=eyes.events.v1
EYES_RESULT_QUEUE=eyes.results.v1
EYES_EVENT_QUEUE_MAX_BYTES=268435456
EYES_EVENT_PUBLISH_CONCURRENCY=4
EYES_EVENT_BROKER_TIMEOUT_SECONDS=3
EYES_CACHE_TTL_SECONDS=60
EYES_CACHE_QUERY_CONCURRENCY=4
EYES_ARTIFACT_ROOT=data/artifacts
EYES_GLOBAL_EXECUTION_LIMIT=16
EYES_GLOBAL_SCORE_LIMIT=4
EYES_LEASE_SECONDS=60
EYES_CANCELLATION_GRACE_SECONDS=60
EYES_SCORE_SUBMISSION_GRACE_SECONDS=60
EYES_SCHEDULER_INTERVAL_SECONDS=5
EYES_MAX_REQUEST_BYTES=8388608
EYES_MAX_SCORE_INPUT_BYTES=33554432
EYES_MAX_ARTIFACT_BYTES=33554432
EYES_MAX_DATASET_CASES=10000
EYES_MAX_EXPERIMENT_RUNS=100000
EYES_MAX_PREPARATION_ATTEMPTS=3
EYES_TRACE_CONSOLE_EXPORT=false
# 0 disables age-based evidence expiration. File cleanup uses the grace periods below.
EYES_EVIDENCE_RETENTION_DAYS=0
EYES_EVENT_RETENTION_DAYS=0
EYES_ARTIFACT_RETENTION_DAYS=0
EYES_REPORT_RETENTION_DAYS=0
EYES_NOTIFICATION_RETENTION_DAYS=7
EYES_PENDING_ARTIFACT_TTL_HOURS=24
EYES_ORPHAN_ARTIFACT_GRACE_HOURS=24

# Local ingestion is disabled by default. Prefer account-scoped source tokens.
# Explicit local ingestion is for a trusted single-user host only, never a proxy.
# EYES_LOCAL_OBSERVATION=false
# With multiple projects, choose which receives local Agent events.
# EYES_LOCAL_OBSERVATION_PROJECT_ID=<project UUID>

# Browser sessions: enable secure cookies on HTTPS deployments.
EYES_SESSION_COOKIE_SECURE=false
EYES_SESSION_HOURS=168
